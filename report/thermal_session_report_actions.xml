<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        page_height = 0 makes wkhtmltopdf render a single, continuously
        extending page rather than a fixed A4-style height — this is
        the standard technique for thermal receipts in Odoo (the exact
        same approach already used and confirmed working for the
        Session Report in the separate pos_session_report module on
        this install), and it is what actually satisfies "extend beyond
        297mm without clipping": a fixed height plus overflow is not
        something wkhtmltopdf paper formats support, so height is fully
        dynamic from the start rather than fixed-then-growing.
    -->
    <record id="paperformat_thermal_session_report" model="report.paperformat">
        <field name="name">Thermal Session Report (80mm, dynamic height)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">0</field>
        <field name="page_width">80</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_thermal_session_report" model="ir.actions.report">
        <field name="name">Thermal Session Report</field>
        <field name="model">pos.session</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">waitress_cash_control.report_thermal_session</field>
        <field name="report_file">waitress_cash_control.report_thermal_session</field>
        <field name="print_report_name">'Thermal Session Report - %s' % (object.name)</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_session"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_thermal_session_report"/>
    </record>
</odoo>
